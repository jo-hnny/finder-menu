// Shared by every target. CI overrides MARKETING_VERSION and CURRENT_PROJECT_VERSION per release.
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 2

// The public key may be committed here or supplied as a build setting by CI.
SPARKLE_PUBLIC_ED_KEY = tgwtXM7rNJwNh7yZAzofYlZm4c5OSsbyuaNy42gtaHc=
// xcconfig treats two slashes as a comment; the empty expansion preserves HTTPS.
SPARKLE_FEED_URL = https:/$()/github.com/jo-hnny/finder-menu/releases/latest/download/appcast.xml

MACOSX_DEPLOYMENT_TARGET = 14.0
SDKROOT = macosx
SWIFT_VERSION = 6.0
CLANG_ENABLE_MODULES = YES
COMBINE_HIDPI_IMAGES = YES

// Local ad-hoc signing; no developer team required.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
