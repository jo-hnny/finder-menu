{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "返回预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to Preview"
          }
        }
      }
    },
    "更改会实时显示在预览中。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes appear in the preview as you edit."
          }
        }
      }
    },
    "检查更新…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        }
      }
    },
    "%lld 项已启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld enabled"
          }
        }
      }
    },
    "Bundle ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle ID"
          }
        }
      }
    },
    "Finder Menu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Menu"
          }
        }
      }
    },
    "Finder 扩展已启用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder extension is on"
          }
        }
      }
    },
    "Finder 扩展运行中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder extension is running"
          }
        }
      }
    },
    "Finder 预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder Preview"
          }
        }
      }
    },
    "Markdown 文档": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown document"
          }
        }
      }
    },
    "上移": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        }
      }
    },
    "下移": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        }
      }
    },
    "仅在选中文件夹时显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show only when folders are selected."
          }
        }
      }
    },
    "仅在选中文件时显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show only when files are selected."
          }
        }
      }
    },
    "仅文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      }
    },
    "仅文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders"
          }
        }
      }
    },
    "全部": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      }
    },
    "关闭编辑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Editor"
          }
        }
      }
    },
    "内置操作": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in action"
          }
        }
      }
    },
    "内置操作 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in · %@"
          }
        }
      }
    },
    "内置操作，可以禁用但不能移除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in action. It can be disabled but not removed."
          }
        }
      }
    },
    "右键菜单": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context Menu"
          }
        }
      }
    },
    "右键菜单预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context menu preview"
          }
        }
      }
    },
    "名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "启用 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable %@"
          }
        }
      }
    },
    "在文件和文件夹的右键菜单中显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in the context menu for files and folders."
          }
        }
      }
    },
    "在菜单中显示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Menu"
          }
        }
      }
    },
    "已在系统设置中启用 Finder 扩展。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder extension is enabled in System Settings."
          }
        }
      }
    },
    "已检测到正在运行的 Finder 扩展，可能来自另一个已安装的应用副本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A running Finder extension was detected. It may belong to another installed copy of the app."
          }
        }
      }
    },
    "已跳过 %lld 个无效的应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped %lld invalid apps."
          }
        }
      }
    },
    "应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application"
          }
        }
      }
    },
    "应用操作": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application action"
          }
        }
      }
    },
    "快速操作": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Actions"
          }
        }
      }
    },
    "打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "扩展状态待确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension status unconfirmed"
          }
        }
      }
    },
    "扩展设置…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension Settings…"
          }
        }
      }
    },
    "找不到应用 · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App not found · %@"
          }
        }
      }
    },
    "找不到这个应用，请重新添加。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find this app. Add it again."
          }
        }
      }
    },
    "拖动 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag %@"
          }
        }
      }
    },
    "拖动左侧手柄排序 · 选中项目编辑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handle to reorder · Select an item to edit"
          }
        }
      }
    },
    "拖动排序 · 选中项目编辑名称和显示范围": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder · Select an item to edit its name and scope"
          }
        }
      }
    },
    "拖动调整顺序": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder"
          }
        }
      }
    },
    "文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        }
      }
    },
    "文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder"
          }
        }
      }
    },
    "显示简介": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Info"
          }
        }
      }
    },
    "显示范围": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show For"
          }
        }
      }
    },
    "暂时无法确认扩展状态，可在系统设置中检查。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extension status cannot currently be confirmed. Check it in System Settings."
          }
        }
      }
    },
    "此处没有已启用的菜单项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No enabled items here"
          }
        }
      }
    },
    "添加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "添加应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add App"
          }
        }
      }
    },
    "移除应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove App"
          }
        }
      }
    },
    "编辑 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit %@"
          }
        }
      }
    },
    "编辑菜单项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Menu Item"
          }
        }
      }
    },
    "自动保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autosave"
          }
        }
      }
    },
    "菜单名称": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Title"
          }
        }
      }
    },
    "菜单名称在回车或离开编辑时保存，其他更改即时保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu titles save on Return or when leaving the editor. Other changes save immediately."
          }
        }
      }
    },
    "菜单项目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu Items"
          }
        }
      }
    },
    "让顺手的操作，触手可及。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the actions you use within reach."
          }
        }
      }
    },
    "退出应用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "退出配置应用后，Finder 菜单仍然可用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Finder menu remains available after quitting this app."
          }
        }
      }
    },
    "选择要加入右键菜单的应用。文件夹支持取决于所选应用。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose apps to add to the context menu. Folder support depends on each app."
          }
        }
      }
    },
    "顺序": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order"
          }
        }
      }
    },
    "预览对象": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview Target"
          }
        }
      }
    },
    "预览本应用菜单的内容与顺序；灰色系统项仅为示意": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews this app's items and order. Gray system items are illustrative."
          }
        }
      }
    }
  },
  "version": "1.0"
}
